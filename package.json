{
  "name": "promptparse",
  "version": "1.6.0",
  "description": "All-in-one JS library for PromptPay & EMVCo QR Codes",
  "author": "Maythiwat Chomchuen <maythiwat.chom@gmail.com>",
  "license": "MIT",
  "keywords": [
    "emvco",
    "emvco-qr",
    "promptpay",
    "promptpay-qr",
    "qr",
    "qrcode",
    "thai-qr-payment",
    "thai-qr-standard",
    "truemoney"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maythiwat/promptparse.git"
  },
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "browser": "dist/index.global.js",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./generate": {
      "import": "./dist/generate/index.mjs",
      "require": "./dist/generate/index.js",
      "types": "./dist/generate/index.d.ts"
    },
    "./validate": {
      "import": "./dist/validate/index.mjs",
      "require": "./dist/validate/index.js",
      "types": "./dist/validate/index.d.ts"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write . && eslint --fix .",
    "build": "rimraf dist && tsup"
  },
  "engines": {
    "pnpm": ">=8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
  }
}
